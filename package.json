{
  "name": "orbital-earth-analog-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node scripts/dev.mjs",
    "start": "node server/index.mjs",
    "test": "node --test server/api.test.mjs",
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "predeploy": "npm run build:pages",
    "deploy": "gh-pages -d dist/client"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "maplibre-gl": "^6.18.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "gh-pages": "^6.3.0",
    "vite": "^8.3.8"
  }
}
