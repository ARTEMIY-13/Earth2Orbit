# Copy to .env (never commit .env). Keys are read only by the Node server.
# The AI guide ORI picks the first configured provider:
#   GEMINI_API_KEY  – Google AI Studio, free tier (best Ukrainian): https://aistudio.google.com/apikey
#   GROQ_API_KEY    – Groq, free tier: https://console.groq.com/keys
#   OPENAI_API_KEY  – OpenAI, paid
# Without any key the server uses the keyless Pollinations service (1 reply / 45 s per server IP)
# and falls back to the built-in project knowledge base when the limit is reached.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# FREE_AI=0   # disable the keyless fallback
